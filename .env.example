# From https://www.sanity.io/manage → your project
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Any long random string; used by the Sanity webhook to refresh the site instantly
SANITY_REVALIDATE_SECRET=

# Optional: your custom domain, used for link previews (defaults to the Vercel production URL)
NEXT_PUBLIC_SITE_URL=
